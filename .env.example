# 이 파일을 .env로 복사한 뒤 값을 채움. 비워 두면 data.json을 읽고 씀
# Supabase 대시보드 > Project Settings > API 에서 복사
SUPABASE_URL=
# 읽기용(anon / publishable) 키
SUPABASE_ANON_KEY=
# 추가 · 삭제용(service_role / secret) 키. RLS를 무시하는 관리자 키라 이 로컬 서버에서만 사용
# 비워 두면 Supabase 모드는 읽기 전용
SUPABASE_SERVICE_ROLE_KEY=

# ---- Vercel 배포 시: 이 파일 대신 Vercel > Settings > Environment Variables 에 넣음
# 공개 주소라 로그인 없이 누구나 접속 가능. 기본은 읽기 전용(SUPABASE_URL + SUPABASE_ANON_KEY만)
# 추가 · 삭제까지 열려면 SUPABASE_SERVICE_ROLE_KEY 와 아래 값을 둘 다 넣음 (로컬에서는 무시됨)
# ALLOW_WRITE=1
